# Yosys generic-gate synthesis of the core (memory excluded).
#   yosys -s tools/synth.ys        ->  build/synth_stat.txt
read_verilog -Irtl rtl/rv64_core.v rtl/decoder.v rtl/imm_gen.v rtl/regfile.v rtl/alu.v rtl/branch_unit.v rtl/forward_unit.v rtl/hazard_unit.v rtl/branch_predictor.v
synth -top rv64_core
tee -o build/synth_stat.txt stat
